# Flutter
build/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.lock
!pubspec.lock
# IDE
.idea/
.vscode/
# macOS
.DS_Store

# Session handoff notes (local only, never shipped)
HANDOFF-*.md

# Local-only Claude instructions (global standard: never commit)
CLAUDE.local.md

# Environment files (global standard: never commit)
.env
.env.*
# ...but the committed template must survive the .env.* rule above
!.env.example

# Build output (global standard: never commit)
dist/

# direnv environment files (can hold exported secrets)
.envrc
.envrc.local
