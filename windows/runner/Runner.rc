/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#define VERSION_AS_NUMBER 1,0,0,1
#define VERSION_AS_STRING "1.0.0.1"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
// The release manifest declares channel internal-rc.1 and signature unsigned.
// The binary has to say the same thing on its own: a PE that carries only
// "Flywheel 1.0.0.1, Zentropy Labs, All rights reserved" reads as a shipped,
// signed release to anyone who right-clicks it. VS_FF_PRERELEASE and
// VS_FF_SPECIALBUILD put that on the file itself, where the manifest cannot.
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE | VS_FF_SPECIALBUILD
#else
 FILEFLAGS VS_FF_PRERELEASE | VS_FF_SPECIALBUILD
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Zentropy Labs" "\0"
            VALUE "FileDescription", "Flywheel (internal release candidate, unsigned)" "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", "FlywheelDesktop" "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Zentropy Labs. All rights reserved." "\0"
            VALUE "OriginalFilename", "FlywheelDesktop.exe" "\0"
            VALUE "ProductName", "Flywheel" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
            // SpecialBuild is the field Explorer surfaces for VS_FF_SPECIALBUILD.
            // Keep it in step with release-manifest.json channel and signature.
            VALUE "SpecialBuild", "internal-rc.1, unsigned, not for redistribution" "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

